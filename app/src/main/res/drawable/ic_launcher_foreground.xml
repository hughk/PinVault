        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Question Mark '?' Dot -->
    <path
        android:pathData="M 54,66.5 L 54,66.6"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>